# Maintainer: Vincent Patrick Chambers <192937334+r3dg0d@users.noreply.github.com>
# Installs the prebuilt v1.000 release archive.
pkgname=ttf-nulltype
pkgver=1.000
pkgrel=1
pkgdesc="An original chamfered monospace for terminals and code: 9 weights + italics, source-preserving ligatures, full box drawing and Powerline."
arch=(any)
url="https://github.com/r3dg0d/nulltype-font"
license=(OFL-1.1)
source=("$url/releases/download/v$pkgver/NullType-v$pkgver.zip")
sha256sums=('34698a47e1700fdaf896299dac1a7afd8486699538a9ba8915558671d9ea277a')

package() {
  cd "NullType-v$pkgver"
  install -Dm644 -t "$pkgdir/usr/share/fonts/TTF" ttf/*.ttf variable/*.ttf
  install -Dm644 -t "$pkgdir/usr/share/fonts/OTF" otf/*.otf
  install -Dm644 OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
}
